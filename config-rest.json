{
  "mode": "rest",
  "port": 8080,
  "cors": true,
  "routes": [
    {
      "method": "GET",
      "path": "/api/health",
      "status": 200,
      "body": { "status": "ok" }
    },
    {
      "method": "GET",
      "path": "/api/users",
      "status": 200,
      "headers": {
        "X-Mock": "ghost-server"
      },
      "body": {
        "users": [
          { "id": 1, "name": "!{RANDOM_STRING} Alice Alla" },
          { "id": 2, "name": "!{RANDOM_STRING} Bob Nob Rob" }
        ]
      }
    },
    {
      "method": "GET",
      "path": "/api/users/:id",
      "status": 200,
      "body": {
        "id": "!{UUID}",
        "score": "!{RANDOM_FLOAT_IN_RANGE} 0.0 100.0",
        "active": "!{RANDOM_BOOL}",
        "name": "!{RANDOM_STRING} Alpha Beta Gama"
      }
    },
    {
      "method": "GET",
      "path": "/api/spinMachine",
      "status": 200,
      "delay_ms": 100,
      "body": {
        "spinId": "!{UUID}",
        "reels": "!{RANDOM_INT_MATRIX} 5 3 0 7"
      }
    },
    {
      "method": "GET",
      "path": "/api/roll",
      "body": {
        "dice": "!{RANDOM_INT_IN_RANGE} 1 6"
      }
    },
    {
      "method": "GET",
      "path": "/api/scenario",
      "body": {
        "step": "!{SEQUENCE_INT} 1 2 3",
        "label": "!{SEQUENCE_STRING} start mid end",
        "ready": "!{SEQUENCE_BOOL} false false true",
        "factor": "!{SEQUENCE_FLOAT} 0.5 1.0 1.5"
      }
    },
    {
      "method": "GET",
      "path": "/api/lorem",
      "body": {
        "text": "!{LOREM} 25"
      }
    },
    {
      "method": "POST",
      "path": "/api/login",
      "status": 401,
      "delay_ms": 200,
      "body": { "error": "invalid_credentials" }
    },
    {
      "method": "GET",
      "path": "/api/ping",
      "body": "pong"
    }
  ]
}
